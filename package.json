{
  "name": "plauti-sfdx",
  "version": "0.1.0",
  "description": "Plauti Duplicate Check CLI Plugin for Salesforce",
  "author": "Plauti",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "/lib",
    "/messages",
    "/oclif.manifest.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@oclif/core": "^4.0.0",
    "@salesforce/core": "^8.0.0",
    "@salesforce/sf-plugins-core": "^12.0.0",
    "fs-extra": "^11.3.3",
    "node-fetch": "^3.3.2",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "clean": "rimraf lib && rimraf tsconfig.tsbuildinfo",
    "compile": "tsc -b",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "postpack": "npm run clean",
    "prepack": "npm run build && oclif manifest && npm run readme",
    "test": "node --test --experimental-test-coverage test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "syntax-check": "node --check lib/**/*.js",
    "readme": "oclif readme",
    "version": "oclif readme && git add README.md"
  },
  "keywords": [
    "oclif-plugin",
    "salesforce",
    "sfdx",
    "sf",
    "plauti",
    "duplicate-check"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/plauti/plauti-sf-cli-plugin.git"
  },
  "oclif": {
    "commands": "./lib/commands",
    "bin": "sf",
    "topicSeparator": ":",
    "devPlugins": [
      "@oclif/plugin-help"
    ]
  }
}
